@startuml topologia-pruebas-aws-2tenants-horizontal
title Topología de Pruebas LinkGuard — AWS + Multi-Tenant (2 tenants)

skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam ArrowColor #34495E
skinparam nodesep 30
skinparam ranksep 120
skinparam noteFontSize 9
scale max 1100x850

' ============================================================
' TENANTS (fila superior)
' ============================================================

together {
    rectangle "admin\n(operador)" as admin_tenant #FFF9C4
    rectangle "tenant-a\nUSER_ID=tenant-a" as tenant_a #E1BEE7
    rectangle "tenant-b\nUSER_ID=tenant-b" as tenant_b #B2DFDB
}

' ============================================================
' ORCHESTRATOR (AWS) — nodo único
' ============================================================

node "Orchestrator + HUB\n34.193.139.170 (AWS us-east-1)\nOrch :8000 XML-RPC | Hub :9000 wg-HUB :51820\nstate.json · secrets · jwt_secret" as Orch #E3F2FD

' ============================================================
' CLOUD PEERS (EC2) — fila horizontal, color por tenant: lila=a, verde=b
' ============================================================

together {
    node "EC2 Ubuntu\n54.210.49.136\nwg0: .2 [a]\npeer-100-31-255-119" as PeerUbuntu #E1BEE7
    node "EC2 Amazon\n3.228.113.66\nwg0: .3 [a]\npeer-34-207-174-76" as PeerAmazon #E1BEE7
    node "EC2 Alma\n98.87.229.24\nwg0: .4 [b]\npeer-184-72-71-143" as PeerAlma #B2DFDB
}

' ============================================================
' TERMINAL PEERS — fila horizontal
' ============================================================

together {
    node "Jump Host\n100.115.215.49\nroot / password" as Jump #FFE0B2
    node "VM40 Alpine\n172.20.0.40\nwg0: .5 [b]\npeer-172-20-0-40 (openrc)" as PeerVM40 #B2DFDB
    node "RPi5\n172.20.0.7\nwg0: .6 [b]\npeer-172-20-0-7 (systemd)" as PeerRPi5 #B2DFDB
}

' ============================================================
' QEMU TESTBED — fila horizontal
' ============================================================

together {
    node "orq Alpine\n192.168.100.10\npeer01 wg0: .7 [a] (openrc)" as QEMUorq #E1BEE7
    node "pa Alpine\n192.168.100.20\npeer02 wg0: .8 [b] (openrc)" as QEMUpa #B2DFDB
    node "pb Alpine\n192.168.100.30\npeer03 wg0: .9 [b] (openrc)" as QEMUpb #B2DFDB
}

' ============================================================
' WIREGUARD OVERLAY
' ============================================================

rectangle "WireGuard Overlay 10.20.30.0/24 | Hub .1 | 8 peers .2-.9 | aislamiento sólo en control-plane" as wg_overlay #BBDEFB

' ============================================================
' RELACIONES — Cadena vertical entre filas (control plane)
' ============================================================

admin_tenant -down-> Orch : ADMIN_TOKEN
tenant_a -down-> Orch : ORCH_TOKEN u_a1
tenant_b -down-> Orch : ORCH_TOKEN u_b2

Orch -down-> PeerUbuntu : auth.login tenant-a
PeerUbuntu -[hidden]right-> PeerAmazon
PeerAmazon -[hidden]right-> PeerAlma

PeerAlma -[hidden]down-> Jump
Jump -[hidden]right-> PeerVM40
PeerVM40 -[hidden]right-> PeerRPi5

PeerRPi5 -[hidden]down-> QEMUorq
QEMUorq -[hidden]right-> QEMUpa
QEMUpa -[hidden]right-> QEMUpb

QEMUpb -[hidden]down-> wg_overlay

' ============================================================
' RELACIONES — Data Plane (representativa por grupo, -up-> hacia Orch)
' ============================================================

PeerUbuntu -up-> Orch : wg-HUB (EC2)
PeerVM40 -up-> Orch : wg-HUB NAT (terminal)
QEMUorq -up-> Orch : wg-HUB NAT (QEMU)

' ============================================================
' LEYENDA al pie (compacta)
' ============================================================

note bottom of wg_overlay
  **Orchestrator**: RPC :8000 · Hub WG :51820 · Red 10.20.30.0/24
  _enforce_tenant_for_peer valida ownership · cross-tenant forbidden (403)
  **tenant-a (lila [a])**: Ubuntu, Amazon, QEMUorq (3)  |  **tenant-b (verde [b])**: Alma, VM40, RPi5, pa, pb (5)
  **Aislamiento**: plano datos compartido 10.20.30.0/24 · control-plane niega peer.get/peer.config cross-tenant
end note

@enduml
