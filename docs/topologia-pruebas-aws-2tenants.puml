@startuml topologia-pruebas-aws-2tenants
title Topología de Pruebas LinkGuard — AWS + Multi-Tenant (2 tenants)

skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam ArrowColor #34495E

' ============================================================
' TENANTS
' ============================================================

rectangle "admin\n(operador global)" as admin_tenant #FFF9C4 {
}

rectangle "tenant-a\n(USER_ID=tenant-a)" as tenant_a #E1BEE7 {
}

rectangle "tenant-b\n(USER_ID=tenant-b)" as tenant_b #B2DFDB {
}

' ============================================================
' ORCHESTRATOR (AWS)
' ============================================================

cloud "AWS us-east-1" as aws_cloud #E3F2FD {

    node "Orchestrator + HUB\n34.193.139.170\necs-linkguard-orquestator" as Orch {
        node "Orchestrator :8000\nXML-RPC /RPC2" as OrchRPC
        node "Hub Agent :9000\nwg-HUB :51820" as HubAgent
        database "state.json\nsecrets\njwt_secret" as OrchState
    }

    node "EC2 — Ubuntu\n54.210.49.136\npeer-100-31-255-119\nwg0: 10.20.30.2" as PeerUbuntu

    node "EC2 — Amazon Linux\n3.228.113.66\npeer-34-207-174-76\nwg0: 10.20.30.3" as PeerAmazon

    node "EC2 — AlmaLinux\n98.87.229.24\npeer-184-72-71-143\nwg0: 10.20.30.4" as PeerAlma
}

' ============================================================
' TERMINAL PEERS (behind jump host)
' ============================================================

rectangle "Red Privada\n172.20.0.0/24" as terminal_net #FFF3E0 {

    node "Jump Host\n100.115.215.49\nroot / password" as Jump

    node "VM40 — Alpine\n172.20.0.40\npeer-172-20-0-40\nwg0: 10.20.30.5\nopenrc" as PeerVM40

    node "RPi5 — Raspberry Pi OS\n172.20.0.7\npeer-172-20-0-7\nwg0: 10.20.30.6\nsystemd" as PeerRPi5
}

' ============================================================
' QEMU TESTBED (local)
' ============================================================

rectangle "Host QEMU (local)" as qemu_host #E8F5E9 {

    rectangle "br0: 192.168.100.0/24\n(management)" as br0 #C8E6C9

    node "orq — Alpine\n192.168.100.10\npeer01\nwg0: 10.20.30.7\nopenrc" as QEMUorq

    node "pa — Alpine\n192.168.100.20\npeer02\nwg0: 10.20.30.8\nopenrc" as QEMUpa

    node "pb — Alpine\n192.168.100.30\npeer03\nwg0: 10.20.30.9\nopenrc" as QEMUpb
}

' ============================================================
' WIREGUARD OVERLAY
' ============================================================

rectangle "WireGuard Overlay\n10.20.30.0/24" as wg_overlay #BBDEFB {
}

' ============================================================
' RELACIONES — Control Plane
' ============================================================

PeerUbuntu -up-> OrchRPC : HTTP/XML-RPC\nauth.login + token tenant-a
PeerAmazon -up-> OrchRPC : HTTP/XML-RPC\nauth.login + token tenant-a
PeerAlma -up-> OrchRPC : HTTP/XML-RPC\nauth.login + token tenant-b

PeerVM40 -up-> Jump : SSH via jump
PeerRPi5 -up-> Jump : SSH via jump
Jump -up-> OrchRPC : HTTP/XML-RPC\n(auth.login tenant-b via NAT)

QEMUorq -up-> OrchRPC : HTTP/XML-RPC\nauth.login + token tenant-a
QEMUpa -up-> OrchRPC : HTTP/XML-RPC\nauth.login + token tenant-b
QEMUpb -up-> OrchRPC : HTTP/XML-RPC\nauth.login + token tenant-b

' ============================================================
' RELACIONES — Data Plane (WireGuard)
' ============================================================

PeerUbuntu --> HubAgent : wg-HUB\nWireGuard
PeerAmazon --> HubAgent : wg-HUB\nWireGuard
PeerAlma --> HubAgent : wg-HUB\nWireGuard
PeerVM40 --> HubAgent : wg-HUB\n(via jump/NAT)
PeerRPi5 --> HubAgent : wg-HUB\n(via jump/NAT)
QEMUorq --> HubAgent : wg-HUB\n(via NAT)
QEMUpa --> HubAgent : wg-HUB\n(via NAT)
QEMUpb --> HubAgent : wg-HUB\n(via NAT)

' ============================================================
' RELACIONES — Tenant ownership (4+4 split)
' ============================================================

admin_tenant ..> Orch : ADMIN_TOKEN\noperaciones globales

' tenant-a
tenant_a ..> PeerUbuntu : ORCH_TOKEN u_a1...
tenant_a ..> PeerAmazon : ORCH_TOKEN u_a1...
tenant_a ..> QEMUorq : ORCH_TOKEN u_a1...

' tenant-b
tenant_b ..> PeerAlma : ORCH_TOKEN u_b2...
tenant_b ..> PeerVM40 : ORCH_TOKEN u_b2...
tenant_b ..> PeerRPi5 : ORCH_TOKEN u_b2...
tenant_b ..> QEMUpa : ORCH_TOKEN u_b2...
tenant_b ..> QEMUpb : ORCH_TOKEN u_b2...

' ============================================================
' QEMU internal
' ============================================================

QEMUorq --> br0
QEMUpa --> br0
QEMUpb --> br0

' ============================================================
' NOTES
' ============================================================

note right of Orch
  **Orchestrator**
  - RPC: :8000/RPC2
  - Hub WG: :51820
  - Red: 10.20.30.0/24
  - _enforce_tenant_for_peer valida ownership
  - cross-tenant forbidden (403)
end note

note bottom of PeerAlma
  **Distribución de peers**
  - tenant-a: Ubuntu, Amazon, QEMUorq (3)
  - tenant-b: Alma, VM40, RPi5, pa, pb (5)
  Cada peer guarda user_id al registrarse.
end note

note top of wg_overlay
  **WireGuard Overlay**
  - Hub: 10.20.30.1
  - 8 peers: 10.20.30.2 - 10.20.30.9
  - Tunnel no distingue tenant: el aislamiento
    se aplica en el control-plane (XML-RPC)
end note

note bottom of QEMUpb
  **Aislamiento sobre overlay compartido**
  Aunque todos los peers ven la red 10.20.30.0/24
  en el plano de datos, el orchestrator niega
  peer.get/peer.config cross-tenant (403).
end note

@enduml