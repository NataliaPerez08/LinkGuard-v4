@startuml topologia-pruebas-aws-2tenants-vertical
title Topología de Pruebas LinkGuard — AWS + Multi-Tenant (2 tenants)

skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam ArrowColor #34495E
skinparam nodesep 20
skinparam ranksep 18
skinparam noteFontSize 9
scale max 850 width

' ============================================================
' TENANTS (fila superior)
' ============================================================

together {
    rectangle "admin\n(operador)" as admin_tenant #FFF9C4
    rectangle "tenant-a\nUSER_ID=tenant-a" as tenant_a #E1BEE7
    rectangle "tenant-b\nUSER_ID=tenant-b" as tenant_b #B2DFDB
}

' ============================================================
' ORCHESTRATOR (AWS) — nodo único compacto
' ============================================================

node "Orchestrator + HUB\n34.193.139.170 (AWS us-east-1)\nOrch :8000 XML-RPC | Hub :9000 wg-HUB :51820\nstate.json · secrets · jwt_secret" as Orch #E3F2FD

' ============================================================
' CLOUD PEERS (EC2) — columna única, color por tenant: lila=a, verde=b
' ============================================================

node "EC2 Ubuntu — 54.210.49.136 — wg0: .2 — peer-100-31-255-119 [a]" as PeerUbuntu #E1BEE7
node "EC2 Amazon Linux — 3.228.113.66 — wg0: .3 — peer-34-207-174-76 [a]" as PeerAmazon #E1BEE7
node "EC2 AlmaLinux — 98.87.229.24 — wg0: .4 — peer-184-72-71-143 [b]" as PeerAlma #B2DFDB

' ============================================================
' TERMINAL PEERS — columna única
' ============================================================

node "Jump Host — 100.115.215.49 — root / password" as Jump #FFE0B2
node "VM40 Alpine — 172.20.0.40 — wg0: .5 — peer-172-20-0-40 (openrc) [b]" as PeerVM40 #B2DFDB
node "RPi5 RPi OS — 172.20.0.7 — wg0: .6 — peer-172-20-0-7 (systemd) [b]" as PeerRPi5 #B2DFDB

' ============================================================
' QEMU TESTBED — columna única
' ============================================================

node "orq Alpine — 192.168.100.10 — peer01 — wg0: .7 (openrc) [a]" as QEMUorq #E1BEE7
node "pa Alpine — 192.168.100.20 — peer02 — wg0: .8 (openrc) [b]" as QEMUpa #B2DFDB
node "pb Alpine — 192.168.100.30 — peer03 — wg0: .9 (openrc) [b]" as QEMUpb #B2DFDB

' ============================================================
' WIREGUARD OVERLAY
' ============================================================

rectangle "WireGuard Overlay 10.20.30.0/24 | Hub .1 | 8 peers .2-.9 | aislamiento sólo en control-plane" as wg_overlay #BBDEFB

' ============================================================
' RELACIONES — Cadena vertical (control plane)
' ============================================================

admin_tenant -down-> Orch : ADMIN_TOKEN
tenant_a -down-> Orch : ORCH_TOKEN u_a1
tenant_b -down-> Orch : ORCH_TOKEN u_b2

Orch -down-> PeerUbuntu : auth.login tenant-a
PeerUbuntu -[hidden]down-> PeerAmazon
PeerAmazon -[hidden]down-> PeerAlma

PeerAlma -[hidden]down-> Jump
Jump -[hidden]down-> PeerVM40
PeerVM40 -[hidden]down-> PeerRPi5

PeerRPi5 -[hidden]down-> QEMUorq
QEMUorq -[hidden]down-> QEMUpa
QEMUpa -[hidden]down-> QEMUpb

QEMUpb -[hidden]down-> wg_overlay

' ============================================================
' RELACIONES — Data Plane (representativa por grupo)
' ============================================================

PeerUbuntu -down-> Orch : wg-HUB (EC2)
PeerVM40 -down-> Orch : wg-HUB NAT (terminal)
QEMUorq -down-> Orch : wg-HUB NAT (QEMU)

' ============================================================
' LEYENDA al pie (compacta)
' ============================================================

note bottom of wg_overlay
  **Orchestrator**: RPC :8000 · Hub WG :51820 · Red 10.20.30.0/24
  _enforce_tenant_for_peer valida ownership · cross-tenant forbidden (403)
  **tenant-a (lila [a])**: Ubuntu, Amazon, QEMUorq (3)  |  **tenant-b (verde [b])**: Alma, VM40, RPi5, pa, pb (5)
  **Aislamiento**: plano datos compartido 10.20.30.0/24 · control-plane niega peer.get/peer.config cross-tenant
end note

@enduml
