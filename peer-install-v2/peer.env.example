# LinkGuard Peer configuration - v2
# IMPORTANTE: Este archivo contiene tokens secretos.
# Permisos recomendados: chmod 600 /etc/linkguard/peer.env

# Orchestrator URL
ORCH_URL=http://REPLACE_WITH_ORCH_IP:8000/RPC2

# Token del peer (obtenido del admin con: orch-cli issue-user-token <user_id>)
# SEC-03: Este campo es obligatorio; el peer no se registrará sin él
ORCH_TOKEN=REPLACE_WITH_YOUR_TOKEN

# Identificador del peer (si no se define, usa el hostname)
PEER_ID=

# Usuario/tenant propietario del peer
USER_ID=

# Tags del peer (para auto-approve de redes, separados por coma)
PEER_TAGS=

# IP pública del peer (opcional, útil detrás de NAT)
# PUBLIC_IP=

# WireGuard
WG_INTERFACE=wg0
WG_DIR=/etc/wireguard
WG_CONF_PATH=/etc/wireguard/wg0.conf
WG_PRIV_KEY_PATH=/etc/wireguard/wg0.key
WG_PUB_KEY_PATH=/etc/wireguard/wg0.pub
WG_KEEPALIVE=25
WG_HEARTBEAT_INTERVAL=25
WG_AUTO_STATE=/etc/wireguard/wg-auto.json
